# Copy this file to .env and fill in real values.
#
#   cp .env.example .env
#   chmod 600 .env
#
# .env is gitignored and must stay that way. Nothing in THIS file may ever
# be a real credential — it is committed, so anything written here is
# public to everyone with repository access, forever, including in history.

PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=tams_db
DB_USER=postgres
DB_PASSWORD=

# Signs login tokens. Must be long, random, and DIFFERENT in production —
# sharing it between environments means a token minted on a laptop is
# accepted by the live server. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Powers ticket PDF/image extraction.
# Create at https://console.anthropic.com/settings/keys — begins sk-ant-api03-
ANTHROPIC_API_KEY=

# Where uploaded ticket files and cargo photos are written. In production
# point this OUTSIDE the repository so a git pull can never delete them,
# e.g. /var/www/tams-uploads
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

CLIENT_URL=http://localhost:3000

# SMTP, used only for password-reset codes. Leave blank and the app runs
# fine — "Forgot password?" simply won't send anything.
#
# For Gmail this is an APP PASSWORD, not your account password: turn on
# 2-step verification, then create one at
# https://myaccount.google.com/apppasswords
# It is shown as four groups of four letters; enter it with no spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
